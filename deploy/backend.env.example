# ──────────────────────────────────────────────────────────────────────────────
# Veloura Apparel — Backend Production Environment
# Copy to /etc/veloura/backend.env on the VPS.
# chmod 600 /etc/veloura/backend.env
# chown root:veloura /etc/veloura/backend.env
# NEVER commit this file with real values to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL — use the connection pooler URL (port 6543)
# for PgBouncer transaction-mode pooling (respects Supabase connection limits)
DATABASE_URL=postgresql+psycopg2://postgres.YOURPROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE-ME-GENERATE-A-LONG-RANDOM-STRING-AT-LEAST-64-CHARS

# ── CORS — allow only your frontend domain ────────────────────────────────────
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Public URL (used to build upload file URLs) ───────────────────────────────
PUBLIC_BASE_URL=https://api.yourdomain.com

# ── File uploads ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200
UPLOAD_DIR=/var/www/veloura-backend/uploads

# ── Cloudinary (image storage) — optional ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=veloura

# ── Email / SMTP ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=orders@yourdomain.com
SMTP_PASSWORD=CHANGE-ME
SMTP_FROM=VELOURA APPAREL <orders@yourdomain.com>
SMTP_SSL=false
ADMIN_NOTIFY_EMAIL=admin@yourdomain.com

# ── Meta Conversions API ───────────────────────────────────────────────────────
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
