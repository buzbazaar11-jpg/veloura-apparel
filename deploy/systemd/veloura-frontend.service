[Unit]
Description=Veloura Apparel — TanStack Start SSR Frontend
Documentation=https://github.com/buzbazaar11-jpg/veloura-apparel
After=network.target
Wants=network-online.target

[Service]
Type=exec
User=veloura
Group=veloura
WorkingDirectory=/var/www/veloura-frontend

# Load production environment variables (VITE_API_URL, NODE_ENV, etc.)
EnvironmentFile=/etc/veloura/frontend.env

# TanStack Start / Nitro SSR server
# The build output is in .output/server/index.mjs
ExecStart=/usr/bin/node /var/www/veloura-frontend/.output/server/index.mjs

Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1

# Graceful shutdown
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=15

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/veloura-frontend /var/log/veloura

LimitNOFILE=65536

# Logging
StandardOutput=append:/var/log/veloura/frontend.log
StandardError=append:/var/log/veloura/frontend-error.log

[Install]
WantedBy=multi-user.target
