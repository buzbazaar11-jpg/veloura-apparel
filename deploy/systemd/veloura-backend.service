[Unit]
Description=Veloura Apparel — FastAPI Backend
Documentation=https://github.com/buzbazaar11-jpg/veloura-apparel
After=network.target
Wants=network-online.target

[Service]
Type=exec
User=veloura
Group=veloura
WorkingDirectory=/var/www/veloura-backend

# Load production environment variables from a secured file
EnvironmentFile=/etc/veloura/backend.env

# Uvicorn with:
#   --workers 2           (2 worker processes — adjust for your CPU count)
#   --worker-class uvicorn.workers.UvicornWorker  (for Gunicorn) OR
#   uvicorn directly with --loop asyncio
# Using Gunicorn + UvicornWorker for production-grade process management:
ExecStart=/var/www/veloura-backend/venv/bin/gunicorn app.main:app \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --worker-class uvicorn.workers.UvicornWorker \
    --worker-tmp-dir /dev/shm \
    --timeout 60 \
    --graceful-timeout 10 \
    --keep-alive 5 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --access-logfile /var/log/veloura/backend-access.log \
    --error-logfile /var/log/veloura/backend-error.log \
    --log-level info \
    --capture-output

# Graceful shutdown on SIGTERM
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/veloura-backend /var/log/veloura

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
