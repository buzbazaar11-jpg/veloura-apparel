# ──────────────────────────────────────────────────────────────────────────────
# Veloura Apparel — Frontend Production Environment
# Copy to .env.production and fill in your values.
# This file is used during `npm run build` to embed public env vars.
# NEVER commit .env.production with real values to git.
# ──────────────────────────────────────────────────────────────────────────────

# Backend API URL — public, safe to include in frontend bundle
VITE_API_URL=https://api.yourdomain.com

# Optional: Supabase public config (only if using Supabase client directly in frontend)
# Only anon/public key — NEVER the service_role key
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
